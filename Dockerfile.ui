# Simulator web UI (static). Runtime config is bind-mounted at /usr/share/nginx/html/config.json
# ({uiServer:{host,port,secure,...}}); without it the UI derives wss://e-simulator-api.<domain>:443.
FROM node:22-alpine AS builder
WORKDIR /usr/builder
COPY . ./
RUN corepack enable && corepack prepare pnpm@10.9.0 --activate \
 && pnpm install --ignore-scripts --frozen-lockfile --filter webui \
 && pnpm --filter webui build

FROM nginx:1.27-alpine
COPY ui/web/docker/nginx-production.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /usr/builder/ui/web/dist /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://127.0.0.1/healthz >/dev/null || exit 1
