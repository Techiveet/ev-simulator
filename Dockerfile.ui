# Simulator web UI. Runtime config is bind-mounted at /usr/app/dist/config.json
# ({uiServer:{host,port,secure,...}}); without it the UI derives e-simulator-api.<domain>:443 (wss).
FROM node:22-alpine AS builder
WORKDIR /usr/builder
COPY . ./
RUN corepack enable && corepack prepare pnpm@10.9.0 --activate \
 && pnpm install --ignore-scripts --frozen-lockfile --filter webui \
 && pnpm --filter webui build

FROM node:22-alpine
ENV NODE_ENV=production
WORKDIR /usr/app
COPY --from=builder /usr/builder/ui/web/dist ./dist
COPY --from=builder /usr/builder/ui/web/start.js ./start.js
COPY --from=builder /usr/builder/ui/web/package.json ./package.json
COPY --from=builder /usr/builder/node_modules/.pnpm /usr/app/node_modules/.pnpm
COPY --from=builder /usr/builder/ui/web/node_modules ./node_modules
USER node
EXPOSE 3030
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD wget -qO- http://127.0.0.1:3030/ >/dev/null || exit 1
CMD ["node", "start.js"]
